---
import '../styles/theme.scss';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import BaseHead from '../components/BaseHead.astro';
import SkipLink from '../components/SkipLink.astro';
import Topbar from '../components/Topbar.astro';
import ProgressBar from '../components/ProgressBar.astro';
import Icon from '../components/Icon.astro';
import Sources from '../components/Sources.astro';
import Footer from '../components/Footer.astro';
import { site } from '../../scripts/config.mjs';
import { getCourse, openLessons, pad, pdfFileName, readingTime } from '../utils/course';

// =============================================================
// LessonLayout - gabarit d'une leçon
//
// - Barre du haut : fil d'Ariane et jauge de lecture.
// - Barre latérale : la progression du cours, puis le sommaire,
//   module par module. Seul le module courant est déplié : les
//   autres se rouvrent d'un clic, sans script (<details>).
// - Zone principale : en-tête (module et rang, titre, chapô, durée
//   de lecture, PDF du module), couverture, « En bref », le contenu
//   MDX (slot), puis la fin de leçon - « Marquer comme terminée »
//   et la navigation précédente / suivante.
// =============================================================
interface Props {
  id: string;
  title: string;
  module: string;
  description?: string;
  cover?: ImageMetadata;
  coverAlt?: string;
}
const { id, title, description, cover, coverAlt } = Astro.props;

// --- Le cours, et la place de la leçon dedans ----------------------
const modules = await getCourse();
const currentModule = modules.find((m) => m.lessons.some((l) => l.id === id))!;
const current = currentModule.lessons.find((l) => l.id === id)!;

// Liste à plat pour la navigation précédente / suivante. Les leçons
// verrouillées en sont EXCLUES : leur page n'existe pas, un bouton
// « Suivant » qui y mène tomberait sur un 404. Le parcours enjambe
// donc le trou et relie les deux leçons ouvertes qui l'encadrent.
const flat = openLessons(modules);
const currentIndex = flat.findIndex((l) => l.id === id);
const prev = currentIndex > 0 ? flat[currentIndex - 1] : null;
const next = currentIndex < flat.length - 1 ? flat[currentIndex + 1] : null;

// La jauge de la barre latérale suit le cours entier. Verrouillées
// exclues, sinon elle resterait bloquée sous les 100 % sans que
// l'apprenant puisse rien y faire.
const courseIds = flat.map((l) => l.id);

// Points-clés du frontmatter : ils font les slides ET le « En bref ».
const slidePoints = current.entry.data.slidePoints ?? [];
const sources = current.entry.data.sources ?? [];
const minutes = readingTime(current.entry.body);

// La langue du cours, réglée dans socle.config.json.
const { lang } = site();
---

<html lang={lang}>
  <head>
    <BaseHead title={title} description={description ?? title} type="article">
      {/* Pose « js » sur <html> AVANT le rendu : c'est ce qui autorise le CSS
          à replier le sommaire sur mobile. Sans script, la classe n'arrive
          jamais, le sommaire reste déplié - et reste donc utilisable. Inline
          et dans le <head> pour qu'aucune image du menu ouvert ne s'affiche
          avant d'être repliée. */}
      <script is:inline>document.documentElement.classList.add('js');</script>
    </BaseHead>
  </head>
  <body>
    <SkipLink />

    <Topbar
      reading
      crumbs={[
        { label: `Module ${currentModule.number}`, href: `/#module-${currentModule.number}` },
        { label: title },
      ]}
    />

    <div class="c-lesson">
      <!-- Barre latérale -->
      <aside class="c-lesson__sidebar" aria-label="Sommaire du cours">
        {/* Ce conteneur porte le collant, pas l'<aside> : l'aside s'étire
            sur toute la hauteur de la leçon pour que son filet rejoigne le
            pied de page, et un élément aussi haut que son parent ne colle
            à rien. C'est donc son contenu qui suit le défilement. */}
        <div class="c-lesson__sidebar-inner">
          <div class="c-lesson__bar">
            <ProgressBar
              lessonIds={courseIds}
              label="Progression du cours"
              variant="bar"
              class="c-lesson__progress"
            />

            {/* Visible sous « medium » et seulement si le script a tourné :
                un bouton qui ne replierait rien ne doit pas s'afficher. */}
            <button
              type="button"
              class="c-lesson__burger"
              data-nav-toggle
              aria-expanded="false"
              aria-controls="lesson-nav"
            >
              <span class="u-hidden-visually" data-nav-toggle-label>Afficher le sommaire</span>
              <span class="c-lesson__burger-icon" aria-hidden="true" />
            </button>
          </div>

          <nav id="lesson-nav" class="c-lesson__nav o-stack o-stack--sm" aria-label="Navigation des leçons">
            {
              modules.map((module) => (
                <details class="c-lesson__module" open={module === currentModule}>
                  <summary class="c-lesson__module-name">
                    <span>
                      {pad(module.number)} · {module.shortName}
                    </span>
                    <Icon name="chevron" size={16} class="c-lesson__chevron" />
                  </summary>
                  <ul class="c-lesson__lessons o-stack o-stack--2xs">
                    {module.lessons.map((lesson) =>
                      lesson.locked ? (
                        <li>
                          <span class="c-lesson__nav-link c-lesson__nav-link--locked">
                            <Icon name="lock" size={20} />
                            <span class="c-lesson__nav-title">
                              {lesson.title}
                              <span class="u-hidden-visually"> (bientôt disponible)</span>
                            </span>
                          </span>
                        </li>
                      ) : (
                        <li>
                          <a
                            href={lesson.url}
                            data-lesson-link={lesson.id}
                            aria-current={lesson.id === id ? 'page' : undefined}
                            class="c-lesson__nav-link"
                          >
                            <span
                              class:list={['c-status', { 'is-current': lesson.id === id }]}
                              aria-hidden="true"
                              data-status
                            />
                            <span class="c-lesson__nav-title">
                              {lesson.title}
                              <span class="u-hidden-visually" data-check hidden> (terminée)</span>
                            </span>
                          </a>
                        </li>
                      )
                    )}
                  </ul>
                </details>
              ))
            }
          </nav>
        </div>
      </aside>

      <!-- Contenu principal. `tabindex="-1"` pour que le lien d'évitement
           y pose vraiment le focus, et pas seulement la vue. -->
      <main id="contenu" tabindex="-1" class="c-lesson__main">
        <article class="c-lesson__article o-wrapper o-wrapper--medium o-stack o-stack--xl">
          <header class="c-lesson__header o-stack o-stack--md">
            <p class="c-lesson__eyebrow">
              Module {currentModule.number} · Leçon {current.position} sur {currentModule.lessons.length}
            </p>
            <h1 class="c-lesson__title">{title}</h1>
            {description && <p class="c-lesson__lead">{description}</p>}

            <div class="c-lesson__meta o-cluster o-cluster--sm o-cluster--middle">
              <span class="c-lesson__duration">
                <Icon name="clock" size={16} />
                {minutes} min de lecture
              </span>
              {
                currentModule.pdf && (
                  <a
                    href={currentModule.pdf}
                    download={pdfFileName(currentModule.name)}
                    class="c-button c-button--small"
                  >
                    <Icon name="download" size={16} />
                    PDF du module
                  </a>
                )
              }
            </div>
          </header>

          {
            cover && (
              <Image
                class="c-lesson__cover"
                src={cover}
                alt={coverAlt ?? ''}
                layout="full-width"
                loading="eager"
              />
            )
          }

          {
            slidePoints.length > 0 && (
              <section class="c-lesson__summary" aria-labelledby="en-bref">
                <h2 id="en-bref" class="c-lesson__summary-title">En bref</h2>
                <ul class="c-lesson__points o-stack o-stack--xs">
                  {slidePoints.map((point) => (
                    <li class="c-lesson__point">{point}</li>
                  ))}
                </ul>
              </section>
            )
          }

          <div class="s-richtext">
            <slot />
          </div>

          {
            sources.length > 0 && (
              <section class="c-lesson__sources o-stack o-stack--md" aria-labelledby="sources">
                <h2 id="sources" class="c-lesson__sources-title">Sources</h2>
                <Sources sources={sources} />
              </section>
            )
          }

          <!-- Fin de leçon : la marquer terminée, puis passer à la suite -->
          <footer class="c-lesson__end o-stack o-stack--lg">
            <div>
              <button
                type="button"
                data-complete-btn
                data-lesson-id={id}
                class="c-button c-button--primary c-button--large"
              >
                <Icon name="check" />
                <span data-complete-label>Marquer comme terminée</span>
              </button>
            </div>

            <nav class="c-lesson__pager o-grid o-grid--halves" aria-label="Leçon précédente / suivante">
              {
                prev ? (
                  <a href={prev.url} class="c-lesson__pager-link">
                    <span class="c-lesson__pager-label">← Leçon précédente</span>
                    <span class="c-lesson__pager-title">{prev.title}</span>
                  </a>
                ) : (
                  <a href="/" class="c-lesson__pager-link">
                    <span class="c-lesson__pager-label">← Retour</span>
                    <span class="c-lesson__pager-title">Accueil du cours</span>
                  </a>
                )
              }
              {
                next ? (
                  <a href={next.url} class="c-lesson__pager-link c-lesson__pager-link--next">
                    <span class="c-lesson__pager-label">Leçon suivante →</span>
                    <span class="c-lesson__pager-title">{next.title}</span>
                  </a>
                ) : (
                  <a href="/" class="c-lesson__pager-link c-lesson__pager-link--next">
                    <span class="c-lesson__pager-label">Fin du cours →</span>
                    <span class="c-lesson__pager-title">Retour au sommaire</span>
                  </a>
                )
              }
            </nav>
          </footer>
        </article>
      </main>
    </div>

    <!-- Hors de <main> : un <footer> qui y est imbriqué perd son rôle de
         repère « contentinfo » pour les lecteurs d'écran. -->
    <Footer />

    <script>
      import { isCompleted, toggleCompleted, PROGRESS_EVENT } from '../scripts/progress';

      // Sommaire repliable (mobile)
      //
      // Le repli est CSS : le script ne fait que poser l'état. Il ne
      // s'occupe pas non plus de refermer au clic sur un lien - la page
      // change, le sommaire repart replié tout seul.
      const navToggle = document.querySelector<HTMLButtonElement>('[data-nav-toggle]');
      const sidebar = document.querySelector<HTMLElement>('.c-lesson__sidebar');
      if (navToggle && sidebar) {
        const label = navToggle.querySelector<HTMLElement>('[data-nav-toggle-label]');
        const setOpen = (open: boolean) => {
          sidebar.classList.toggle('is-nav-open', open);
          navToggle.setAttribute('aria-expanded', String(open));
          if (label) label.textContent = open ? 'Masquer le sommaire' : 'Afficher le sommaire';
        };

        navToggle.addEventListener('click', () => {
          setOpen(!sidebar.classList.contains('is-nav-open'));
        });

        // Échap referme, et rend le focus au bouton : sans ça, on se
        // retrouve à tabuler dans un sommaire qu'on croyait fermé.
        document.addEventListener('keydown', (event) => {
          if (event.key === 'Escape' && sidebar.classList.contains('is-nav-open')) {
            setOpen(false);
            navToggle.focus();
          }
        });
      }

      // Bouton « Marquer comme terminée » : plein tant que la leçon reste à
      // faire, en contour une fois faite - l'action principale s'efface
      // quand elle est accomplie, sans disparaître (on peut se raviser).
      const btn = document.querySelector<HTMLButtonElement>('[data-complete-btn]');
      if (btn) {
        const lessonId = btn.dataset.lessonId!;
        const label = btn.querySelector<HTMLElement>('[data-complete-label]');
        const render = () => {
          const done = isCompleted(lessonId);
          if (label) label.textContent = done ? 'Leçon terminée - annuler' : 'Marquer comme terminée';
          btn.classList.toggle('c-button--primary', !done);
          btn.classList.toggle('c-button--outline', done);
        };
        btn.addEventListener('click', () => {
          toggleCompleted(lessonId);
          render();
        });
        render();
      }

      // État « terminée » des leçons dans la barre latérale
      function refreshNav() {
        document.querySelectorAll<HTMLElement>('[data-lesson-link]').forEach((link) => {
          const done = isCompleted(link.dataset.lessonLink!);
          link.querySelector('[data-status]')?.classList.toggle('is-done', done);
          const check = link.querySelector<HTMLElement>('[data-check]');
          if (check) check.hidden = !done;
        });
      }
      refreshNav();
      window.addEventListener(PROGRESS_EVENT, refreshNav);
    </script>
  </body>
</html>
