---
// =============================================================
// Icon - les quelques pictogrammes de l'interface
//
// Des tracés au trait, en `currentColor` : l'icône prend la couleur
// du texte qu'elle accompagne, survol compris. Toujours décorative
// (`aria-hidden`) - le texte voisin dit ce qu'elle montre. Une icône
// seule dans un bouton demande un intitulé sur le bouton lui-même.
//
// Ajouter une icône : une entrée de plus dans PATHS, dessinée sur une
// grille de 24 × 24, trait de 2.
// =============================================================
interface Props {
  name: keyof typeof PATHS;
  /** Côté en pixels. */
  size?: number;
  class?: string;
}

const PATHS = {
  'arrow-right': '<path d="M5 12h14M13 6l6 6-6 6"/>',
  'arrow-left': '<path d="M19 12H5M11 6l-6 6 6 6"/>',
  check: '<path d="M5 12.5l4.5 4.5L19 7"/>',
  chevron: '<path d="M6 9l6 6 6-6"/>',
  clock: '<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>',
  download: '<path d="M12 3v12M7 10l5 5 5-5M5 21h14"/>',
  external: '<path d="M14 4h6v6M20 4l-9 9M18 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h5"/>',
  lock: '<rect x="5" y="11" width="14" height="10" rx="2"/><path d="M8 11V8a4 4 0 0 1 8 0v3"/>',
  play: '<path d="M7 4v16l13-8z" fill="currentColor" stroke="none"/>',
  slides: '<rect x="3" y="4" width="18" height="13" rx="2"/><path d="M8 21h8M12 17v4"/>',
};

const { name, size = 18, class: className } = Astro.props;
---

<svg
  class:list={['c-icon', className]}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
  set:html={PATHS[name]}
/>
