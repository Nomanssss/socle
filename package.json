{
  "name": "socle",
  "version": "1.0.0",
  "description": "Template Astro réutilisable pour MOOC / cours en ligne (statique, sans backend).",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "predev": "npm run brand",
    "build": "astro build",
    "prebuild": "npm run brand",
    "preview": "astro preview",
    "check": "astro check",
    "astro": "astro",
    "brand": "node scripts/apply-brand.mjs",
    "slides:theme": "npm run brand && sass src/styles/marp/theme.scss slides/theme.css --load-path=node_modules --style expanded --no-source-map",
    "slides:preview": "node scripts/preview-slides.mjs",
    "slides": "npm run slides:theme && node scripts/build-slides.mjs",
    "slides:html": "npm run slides:theme && node scripts/build-slides.mjs --format=html",
    "slides:pptx": "npm run slides:theme && node scripts/build-slides.mjs --format=pptx",
    "slides:lecons": "npm run slides:theme && node scripts/build-slides.mjs --only=lecons",
    "slides:lecons:html": "npm run slides:theme && node scripts/build-slides.mjs --format=html --only=lecons",
    "slides:modules": "npm run slides:theme && node scripts/build-slides.mjs --only=modules",
    "slides:modules:html": "npm run slides:theme && node scripts/build-slides.mjs --format=html --only=modules",
    "bundle": "npm run slides && npm run slides:html && npm run build && node scripts/bundle-dist.mjs",
    "reset": "node scripts/reset-content.mjs"
  },
  "keywords": [
    "astro",
    "mooc",
    "template",
    "cours",
    "sass"
  ],
  "author": "Alexandre Allain",
  "license": "MIT",
  "dependencies": {
    "@astrojs/mdx": "^7.0.3",
    "astro": "^7.0.9",
    "sass": "^1.101.0",
    "sass-em": "^3.1.0",
    "sass-mq": "^7.0.1",
    "sass-rem": "^4.1.0"
  },
  "devDependencies": {
    "@marp-team/marp-cli": "^4.4.1",
    "gray-matter": "^4.0.3"
  }
}
